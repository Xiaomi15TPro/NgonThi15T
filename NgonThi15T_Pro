local PlaceId = game.PlaceId

local Games = {
    [79268393072444] = "https://www.xhider.xyz/raw/ChaMucNguyen/SellLemons",
    [10449761463]    = "https://www.xhider.xyz/raw/ChaMucNguyen/ChaMucTSB",
}

local DefaultScript = "https://www.xhider.xyz/raw/ChaMucNguyen/BuonCuoivcl"

local Url = Games[PlaceId] or DefaultScript

local Success, Result = pcall(function()
    return game:HttpGet(Url)
end)

if Success and Result then
    loadstring(Result)()
else
    warn("Failed to load script:", Result)
end
